# Copy this file to .env and fill in the values.
#   cp .env.example .env

# --- Discord (required) ---
# Your Discord user-account token. See the README for how to obtain it.
# WARNING: self-bots violate Discord's ToS. Use a throwaway/secondary account.
DISCORD_TOKEN=

# JSON list of Server (guild) IDs to capture. Empty list = capture every
# server the account can see. Enable Developer Mode in Discord, then
# right-click a server icon -> "Copy Server ID".
# Example: SERVER_IDS=[111111111111111111, 222222222222222222]
SERVER_IDS=[]

# --- Storage ---
# SQLite by default. For Postgres use e.g.:
#   postgresql+asyncpg://discord_recall:discord_recall@localhost:5433/discord_recall
DATABASE_URL=sqlite+aiosqlite:///discord_recall.db

# --- LLM enrichment (required for digests / ask) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# --- Telegram delivery (optional) ---
# Bot token from @BotFather, and the chat ID to deliver digests to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tuning ---
LOG_LEVEL=INFO
# Messages fetched per Discord API call during backfill.
BACKFILL_BATCH_SIZE=100
# Pause (seconds) between backfill batches to avoid rate limiting.
BACKFILL_DELAY_SECONDS=1.0
